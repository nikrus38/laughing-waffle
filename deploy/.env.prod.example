# Скопируйте в deploy/.env и заполните. Файл НЕ коммитится.

DOMAIN=fintwin.duckdns.org
DJANGO_SECRET_KEY=replace-with-50-random-characters

POSTGRES_DB=fintwin
POSTGRES_USER=fintwin
POSTGRES_PASSWORD=replace-with-strong-password

SEED_DEMO=1
GUNICORN_WORKERS=3

# Админка: логин и пароль суперпользователя (создаётся при старте контейнера)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_EMAIL=admin@example.invalid
