# Скопируйте в .env и заполните локально. Файл .env в git не попадает.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Telegram Mini App (не коммитить настоящий токен)
TELEGRAM_BOT_TOKEN=

# Куда собирается React-консоль (по умолчанию ../dist)
FRONTEND_DIST=

# База данных. По умолчанию SQLite (api/db.sqlite3).
# Для PostgreSQL задайте строку подключения:
# DATABASE_URL=postgresql://fintwin:password@127.0.0.1:5432/fintwin
# DB_CONN_MAX_AGE=60
#
# Альтернатива без URL:
# DB_ENGINE=postgres
# POSTGRES_DB=fintwin
# POSTGRES_USER=fintwin
# POSTGRES_PASSWORD=password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
